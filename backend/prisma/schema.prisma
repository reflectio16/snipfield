// Prisma schema for snipfield

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  NOTE
  IMAGE
  LINK
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  items     Item[]
}

model Item {
  id         Int      @id @default(autoincrement())
  type       ItemType
  title      String?
  content    String?
  url        String?
  imagePath  String?
  createdAt  DateTime @default(now())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}
